  "stress": [
    {
      "id": "stress_vacancy",
      "name": "Rent interruption",
      "symbol": "m months of zero rent plus re-tenanting downtime",
      "formula": "Lost rent = monthly verified rent × m; add verified downtime costs",
      "sources": [
        "sec_release",
        "sec_10k"
      ]
    },
    {
      "id": "stress_leakage",
      "name": "NNN cost leakage",
      "symbol": "c = annual owner-paid costs not recovered",
      "formula": "Net operating income = verified rent − verified unrecovered owner costs",
      "sources": [
        "sec_10k",
        "prop13"
      ]
    },
    {
      "id": "stress_capex",
      "name": "Re-tenanting / capital shock",
      "symbol": "K = tenant improvements, leasing commissions, roof/HVAC/seismic/parking capital",
      "formula": "Subtract K in the year incurred; do not assume zero because lease is labeled NNN",
      "sources": [
        "sec_10k",
        "usgs_faq"
      ]
    },
    {
      "id": "stress_exit",
      "name": "Exit valuation shock",
      "symbol": "Δcap = change in market cap rate; ΔNOI = change in stabilized NOI",
      "formula": "Exit value = stabilized NOI ÷ market cap rate; both inputs require evidence",
      "sources": [
        "treasury",
        "sec_release"
      ]
    },
    {
      "id": "stress_discount",
      "name": "Discount-rate shock",
      "symbol": "Δr = change in owner-required return",
      "formula": "PV = Σ after-tax cash flow_t ÷ (1+r)^t; r is not the Treasury yield by default",
      "sources": [
        "treasury",
        "irs_544"
      ]
    },
    {
      "id": "stress_tax",
      "name": "Tax / transfer-cost shock",
      "symbol": "ΔT = change in federal/state/local tax and transfer costs",
      "formula": "Net sale proceeds = price − debt payoff − transaction costs − verified taxes",
      "sources": [
        "ula",
        "irs_544",
        "ftb_capgains"
      ]
    },
    {
      "id": "stress_hazard",
      "name": "Hazard / insurance shock",
      "symbol": "Uninsured loss U, deductible D, premium increase P, business-interruption gap B",
      "formula": "Owner loss = U + D + unrecovered rent interruption + P; county EAL is not a parcel loss estimate",
      "sources": [
        "fema_county_query",
        "cdi_claims",
        "usgs_faq"
      ]
    }
  ],
